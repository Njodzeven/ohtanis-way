# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== API CONFIGURATION ====================
# Backend API URL
# Development
VITE_API_URL=http://localhost:8000

# Production (example)
# VITE_API_URL=https://your-backend-api.onrender.com

# ==================== NOTES ====================
# 1. All Vite environment variables must be prefixed with VITE_
# 2. These variables are embedded in the built frontend at build time
# 3. Do NOT put sensitive secrets here - they will be exposed in the browser
# 4. For production builds, set these in your deployment platform (Render, Vercel, etc.)
