# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== DATABASE ====================
# PostgreSQL Connection (for user accounts and chart storage)
POSTGRES_URL=postgresql://ohtani:your_password@localhost:5433/ohtani_db

# MongoDB Connection (for mandala chart data)
MONGO_URI=mongodb://ohtani:your_password@localhost:27017/ohtani_db?authSource=admin

# ==================== AUTHENTICATION ====================
# JWT Secret - CRITICAL: Generate unique secret for production
# Generate with: openssl rand -base64 32
# NEVER use the same secret across environments
JWT_SECRET=your_jwt_secret_here_CHANGE_IN_PRODUCTION

# ==================== EXTERNAL APIS ====================
# Google Gemini API Key for AI chart generation
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== SERVER CONFIGURATION ====================
# Port the backend will run on
PORT=8000

# Node environment (development | production | test)
NODE_ENV=development

# CORS Allowed Origins (comma-separated, no spaces)
# Development default
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Production example
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ==================== DOCKER (Optional) ====================
# Only needed if you're using docker-compose locally
# These can be different from the actual DB connection strings above

POSTGRES_USER=ohtani
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=ohtani_db
POSTGRES_PORT=5433

MONGO_USER=ohtani
MONGO_PASSWORD=strong_password_here
MONGO_PORT=27017

# ==================== SECURITY NOTES ====================
# 1. NEVER commit the actual .env file to version control
# 2. Generate strong random passwords for production:
#    openssl rand -base64 24
# 3. Use different secrets for each environment
# 4. Rotate secrets regularly
# 5. In cloud deployment (Render, Heroku, etc.), set these as environment variables
#    in your dashboard, NOT in .env files
